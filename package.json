{
  "name": "agent-loop-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "scan": "curl -s -X POST http://localhost:3000/scan",
    "gauntlet": "tsx src/gauntlet.ts",
    "gauntlet:example": "tsx src/gauntlet.ts --mutation gauntlet/mutations/example.json",
    "gauntlet:requirements": "tsx src/gauntlet.ts --mutation gauntlet/mutations/002-requirement-gates.json"
  },
  "dependencies": {
    "express": "^4.21.2",
    "inngest": "^3.40.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.0"
  }
}
